// Cloudflare deploy settings. "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "davisonmerch",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Worker runs before every page so the redirect below applies to pages too, not just /api/.
  // Main domain. Visitors to any other domain on this site (davisonmerch.com, www, davlinsupply.com)
  // are sent here with a permanent (301) redirect. API calls and *.workers.dev are left alone.
  "vars": {
    "PRIMARY_HOST": "davlinmerch.com"
  },
  // Keep any variables added in the Cloudflare dashboard when GitHub deploys.
  "keep_vars": true
}
